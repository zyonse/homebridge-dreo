{
  "displayName": "Homebridge Dreo",
  "name": "homebridge-dreo",
  "version": "4.3.0",
  "description": "Homebridge Plugin for Dreo Smart Devices",
  "homepage": "https://github.com/zyonse/homebridge-dreo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyonse/homebridge-dreo.git"
  },
  "bugs": {
    "url": "https://github.com/zyonse/homebridge-dreo/issues"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/zyonse"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src test --ext .ts --max-warnings=0",
    "test": "vitest run",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "homebridge-plugin",
    "dreo",
    "fan",
    "tower"
  ],
  "dependencies": {
    "axios": "^1.3.5",
    "crypto-js": "^4.1.1",
    "reconnecting-websocket": "^4.4.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@homebridge/hap-nodejs": "^2.1.7",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.1",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
